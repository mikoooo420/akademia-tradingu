# Ścieżka bazowa strony. Na GitHub Pages ustawia ją automatycznie workflow (np. /akademia-tradingu).
# Lokalnie zostaw pustą.
NEXT_PUBLIC_BASE_PATH=

# (Opcjonalnie) domyślny klucz API Finnhub wbudowany w stronę – https://finnhub.io/register
# UWAGA: na stronie statycznej klucz jest widoczny dla każdego odwiedzającego.
# Bezpieczniej zostawić puste – każdy użytkownik może wpisać własny klucz w aplikacji
# (przycisk „Źródło notowań”), a klucz zostaje tylko w jego przeglądarce.
NEXT_PUBLIC_FINNHUB_API_KEY=
