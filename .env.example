# Klucz API Finnhub (darmowy: https://finnhub.io/register)
# Używany do notowań w czasie rzeczywistym i wyszukiwania spółek.
# Bez klucza aplikacja korzysta z publicznego endpointu Yahoo Finance,
# a gdy ten jest niedostępny – z danych symulowanych.
FINNHUB_API_KEY=

# Wymuś tryb danych symulowanych (przydatne offline lub na prezentacjach): "mock" | "auto"
MARKET_DATA_MODE=auto
